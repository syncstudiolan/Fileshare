{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fileshare-directory",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    "LOCAL_PERSONAL_URL": "https://fileshare-personal-7ee7299b34.modeltech0.workers.dev"
  },
  "services": [
    {"binding": "LOCAL_PERSONAL_WORKER", "service": "fileshare-personal-7ee7299b34"}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fileshare-directory-db",
      "database_id": "b86988f1-3b66-41d9-ba24-17de5ce33f14"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
